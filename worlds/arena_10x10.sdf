<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arena_10x10">
    <!-- Physics parameters -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.30 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena Perimeter Walls (10m x 10m enclosure centered at origin) -->
    <!-- North Wall: y = +5.05 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10.1 0.1 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10.1 0.1 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall: y = -5.05 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10.1 0.1 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10.1 0.1 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall: x = +5.05 -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.05 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 10.1 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 10.1 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall: x = -5.05 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.05 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 10.1 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 10.1 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 5 Static Obstacles (Positions from Blueprint: (2,2), (-2,1.5), (1,-2), (-1.5,-1), (0,2.5)) -->
    <!-- Obstacle 1: (2, 2) -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>2.0 2.0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient>
            <diffuse>0.9 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: (-2, 1.5) -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>-2.0 1.5 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient>
            <diffuse>0.9 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: (1, -2) -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>1.0 -2.0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient>
            <diffuse>0.9 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: (-1.5, -1) -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>-1.5 -1.0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient>
            <diffuse>0.9 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 5: (0, 2.5) -->
    <model name="obstacle_5">
      <static>true</static>
      <pose>0.0 2.5 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient>
            <diffuse>0.9 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
